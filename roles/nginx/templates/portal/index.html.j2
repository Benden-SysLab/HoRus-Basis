<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HoRus Control Plane</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    :root { color-scheme: dark; --bg:#07101d; --panel:#111d2d; --line:#26364d; --text:#eef5ff; --muted:#91a4bd; --accent:#00b7ff; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; font-family:Segoe UI,Roboto,Arial,sans-serif; color:var(--text); background:radial-gradient(circle at 75% 0,#123259 0,transparent 35%),linear-gradient(145deg,#050b14,#0b1727 55%,#08111e); }
    header { padding:34px clamp(24px,6vw,90px) 22px; border-bottom:1px solid var(--line); background:rgba(5,11,20,.78); backdrop-filter:blur(12px); }
    .brand { display:flex; align-items:center; gap:18px; }
    .brand-logo { width:170px; height:72px; display:block; object-fit:contain; object-position:left center; }
    h1 { margin:0; font-size:clamp(26px,4vw,42px); letter-spacing:.04em; }
    header p { margin:8px 0 0 188px; color:var(--muted); }
    main { padding:38px clamp(24px,6vw,90px); }
    .section-title { display:flex; justify-content:space-between; align-items:end; margin-bottom:26px; }
    .section-title h2 { margin:0; font-size:20px; }
    #status { color:var(--muted); font-size:14px; }
    #services { display:flex; flex-direction:column; gap:36px; }
    .service-group h2 { margin:0 0 16px; font-size:18px; letter-spacing:.12em; color:#b8cae0; text-transform:uppercase; }
    .services-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
    .card { min-height:170px; padding:24px; border:1px solid var(--line); border-radius:18px; color:inherit; text-decoration:none; background:linear-gradient(145deg,rgba(23,39,59,.94),rgba(13,25,41,.94)); transition:.18s ease; position:relative; overflow:hidden; }
    .card:before { content:""; position:absolute; inset:0 auto 0 0; width:4px; background:var(--service-color,var(--accent)); }
    .card:hover { transform:translateY(-3px); border-color:var(--service-color,var(--accent)); box-shadow:0 15px 40px rgba(0,0,0,.28); }
    .card-head { display:flex; justify-content:space-between; gap:12px; align-items:center; }
    .card h3 { margin:0; font-size:22px; }
    .badge { padding:5px 10px; border-radius:999px; background:rgba(27,196,125,.13); color:#54e5a7; font-size:12px; border:1px solid rgba(84,229,167,.35); }
    .card p { color:var(--muted); line-height:1.55; margin:18px 0 0; }
    .empty { color:var(--muted); border:1px dashed var(--line); border-radius:18px; padding:28px; }
    @media (max-width:1100px) { .services-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media (max-width:700px) {
      .services-grid { grid-template-columns:1fr; }
      header p { margin-left:0; }
      .brand-logo { width:130px; }
    }
  </style>
</head>
<body>
  <header><div class="brand"><img class="brand-logo" src="/bsl-logo.svg" alt="Benden-SysLab"><h1>HoRus Control Plane</h1></div><p>Внутренняя панель управления инфраструктурой</p></header>
  <main><div class="section-title"><h2>Доступные сервисы</h2><span id="status">Загрузка…</span></div><section id="services"></section></main>
  <script>
    async function loadServices() {
      const root = document.getElementById('services');
      const status = document.getElementById('status');
      try {
        const listing = await fetch('/portal-services/', {cache:'no-store'}).then(r => r.json());
        const files = listing.filter(x => x.type === 'file' && x.name.endsWith('.json'));
        const services = await Promise.all(files.map(x => fetch('/portal-services/' + encodeURIComponent(x.name), {cache:'no-store'}).then(r => r.json())));
        const categories = ['NET', 'Infra', 'Service'];
        const grouped = services.reduce((result, service) => {
          const category = service.category || 'Service';
          (result[category] ||= []).push(service);
          return result;
        }, {});
        root.innerHTML = categories.filter(category => grouped[category]?.length).map(category => {
          const cards = grouped[category]
            .sort((a,b) => (a.order || 999) - (b.order || 999))
            .map(s => `<a class="card" style="--service-color:${s.color || '#00b7ff'}" href="${s.url}"><div class="card-head"><h3>${s.name}</h3><span class="badge">доступен</span></div><p>${s.description || ''}</p></a>`)
            .join('');
          return `<section class="service-group"><h2>${category}</h2><div class="services-grid">${cards}</div></section>`;
        }).join('');
        if (!services.length) root.innerHTML = '<div class="empty">Сервисы будут появляться здесь по мере установки этапов.</div>';
        status.textContent = `Активно: ${services.length}`;
      } catch (_) { root.innerHTML = '<div class="empty">Не удалось загрузить список сервисов.</div>'; status.textContent = 'Ошибка'; }
    }
    loadServices();
  </script>
</body>
</html>
