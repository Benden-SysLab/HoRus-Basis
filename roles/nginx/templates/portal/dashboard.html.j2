<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HoRus Control Plane</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v={{ nginx_portal_asset_version }}">
  <style>
    :root { color-scheme:dark; --panel:#111d2d; --line:rgba(143,183,225,.22); --text:#eef5ff; --muted:#91a4bd; --accent:#00b7ff; --ok:#31d49b; --down:#ff6b7a; }
    * { box-sizing:border-box; }
    html,body { min-height:100%; }
    body { margin:0; min-height:100dvh; font-family:Segoe UI,Roboto,Arial,sans-serif; color:var(--text); background:radial-gradient(circle at 75% 0,#123259 0,transparent 34%),linear-gradient(145deg,#050b14,#0b1727 55%,#08111e); }
    header { height:clamp(82px,11vh,118px); padding:clamp(13px,2vh,20px) clamp(18px,4vw,64px); border-bottom:1px solid var(--line); background:rgba(5,11,20,.68); backdrop-filter:blur(18px); }
    .brand { display:flex; align-items:center; gap:clamp(12px,2vw,20px); }
    .brand-logo { width:clamp(96px,10vw,142px); height:auto; display:block; }
    h1 { margin:0; font-size:clamp(22px,2.6vw,36px); letter-spacing:.04em; }
    header p { margin:4px 0 0 clamp(0px,12vw,162px); color:var(--muted); font-size:clamp(11px,1vw,14px); }
    main { min-height:calc(100dvh - clamp(82px,11vh,118px)); padding:clamp(12px,2vh,22px) clamp(18px,4vw,64px) 18px; display:flex; flex-direction:column; }
    .page-title { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:clamp(10px,1.4vh,16px); }
    .page-title h2 { margin:0; font-size:clamp(17px,1.5vw,21px); }
    #status { color:var(--muted); font-size:12px; white-space:nowrap; }
    #services { flex:1; min-height:0; display:flex; flex-direction:column; align-items:stretch; gap:clamp(9px,1vw,14px); }
    details { border:1px solid var(--line); border-radius:18px; background:linear-gradient(145deg,rgba(21,39,61,.58),rgba(7,17,30,.46)); box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 16px 40px rgba(0,0,0,.15); backdrop-filter:blur(18px) saturate(130%); overflow:hidden; }
    summary { cursor:pointer; list-style:none; user-select:none; }
    summary::-webkit-details-marker { display:none; }
    .group-summary { min-height:46px; display:flex; align-items:center; gap:10px; padding:9px 15px; font-size:clamp(16px,1vw,20px); font-weight:750; letter-spacing:.1em; color:#c7d8eb; text-transform:uppercase; }
    .group-summary::before { content:'›'; color:var(--accent); font-size:19px; line-height:1; transition:transform .18s ease; }
    details[open] > .group-summary::before { transform:rotate(90deg); }
    .group-count { margin-left:auto; color:var(--muted); font-size:clamp(12px,.75vw,15px); letter-spacing:0; font-weight:500; }
    .group-body { padding:3px 11px 11px; }
    .subgroup { border-color:rgba(245,158,11,.24); background:rgba(17,29,45,.28); }
    .subgroup + .subgroup { margin-top:8px; }
    .subgroup-summary { min-height:40px; display:flex; align-items:center; gap:9px; padding:8px 12px; color:#f7c86c; font-size:clamp(15px,.9vw,18px); font-weight:700; }
    .subgroup-summary::before { content:'›'; font-size:17px; transition:transform .18s ease; }
    .subgroup[open] > .subgroup-summary::before { transform:rotate(90deg); }
    .subgroup .tiles { padding:5px 9px 10px; }
    .tiles { --item-count:1; width:100%; display:grid; grid-template-columns:repeat(var(--item-count),minmax(0,1fr)); gap:clamp(9px,.9vw,15px); align-items:stretch; }
    .tile { container-type:inline-size; min-width:0; min-height:clamp(120px,9vw,160px); padding:clamp(10px,1vw,16px); border:1px solid rgba(147,188,229,.25); border-radius:12px; color:inherit; text-decoration:none; background:linear-gradient(145deg,rgba(34,58,87,.94),rgba(12,27,45,.93)); box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 7px 16px rgba(0,0,0,.22); backdrop-filter:blur(13px); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:clamp(7px,.65vw,11px); position:relative; overflow:hidden; transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease; }
    .tile::before { content:''; position:absolute; inset:0 0 auto; height:2px; background:var(--service-color,var(--accent)); }
    .tile:hover,.tile:focus-visible { transform:translateY(-3px); border-color:var(--service-color,var(--accent)); box-shadow:0 14px 30px rgba(0,0,0,.28); outline:none; }
    .availability { display:inline-flex; align-items:center; gap:6px; min-height:22px; padding:4px 9px; border:1px solid rgba(49,212,155,.34); border-radius:999px; color:var(--ok); background:rgba(49,212,155,.09); font-size:clamp(10px,3.5cqi,13px); line-height:1; text-transform:uppercase; letter-spacing:.04em; }
    .availability::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; box-shadow:0 0 8px currentColor; }
    .tile.is-down { opacity:.62; }
    .tile.is-down .availability { color:var(--down); border-color:rgba(255,107,122,.34); background:rgba(255,107,122,.09); }
    .tile.is-checking .availability { color:var(--muted); border-color:var(--line); background:rgba(145,164,189,.08); }
    .tile-icon { width:clamp(54px,22cqi,84px); height:clamp(54px,22cqi,84px); object-fit:contain; filter:drop-shadow(0 6px 10px rgba(0,0,0,.28)); }
    .tile-name { max-width:100%; color:#f4f8ff; font-size:clamp(15px,5cqi,22px); font-weight:650; line-height:1.15; text-align:center; overflow-wrap:anywhere; }
    .empty { color:var(--muted); border:1px dashed var(--line); border-radius:16px; padding:28px; }
    @media (max-width:1050px) {
      main { height:auto; }
      .group-body,.subgroup,.subgroup .tiles { height:auto; }
      .tiles { grid-template-columns:repeat(auto-fit,minmax(118px,1fr)); }
      .tile { min-height:126px; }
    }
    @media (max-width:700px) {
      header p { margin-left:0; }
      .brand { align-items:flex-start; }
      .tiles { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
      .tile { min-height:118px; }
      .tile-icon { width:54px; height:54px; }
    }
    @media (max-width:380px) {
      .brand { flex-direction:column; }
      .page-title { align-items:flex-start; flex-direction:column; gap:7px; }
      .tiles { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
  </style>
</head>
<body>
  <header><div class="brand"><img class="brand-logo" src="/bsl-logo.svg?v={{ nginx_portal_asset_version }}" alt="Benden-SysLab"><h1>HoRus Control Plane</h1></div><p>Внутренняя панель управления инфраструктурой</p></header>
  <main><div class="page-title"><h2>Доступные сервисы</h2><span id="status">Загрузка…</span></div><section id="services"></section></main>
  <script>
    const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    const serviceIcons = {
      'Vault': '/icons/vault.svg',
      'Access': '/icons/keycloak.svg',
      'Gitea': '/icons/gitea.svg',
      'Wiki.js': '/icons/wikijs.svg',
      'Vikunja': '/icons/vikunja.svg',
      'Registry': '/icons/registry.svg',
      'Jenkins': '/icons/jenkins.svg',
      'Grafana': '/icons/observability.svg'
    };
    const assetUrl = path => `${path || '/favicon.svg'}${String(path || '').includes('?') ? '&' : '?'}v={{ nginx_portal_asset_version }}`;
    const tile = service => `<a class="tile is-checking" data-service-id="${escapeHtml(service.id)}" style="--service-color:${escapeHtml(service.color || '#00b7ff')}" href="${escapeHtml(service.url)}" title="${escapeHtml(service.description || service.name)}"><span class="availability">проверка</span><img class="tile-icon" src="${escapeHtml(assetUrl(service.icon || serviceIcons[service.name]))}" alt="${escapeHtml(service.name)}" loading="lazy"><span class="tile-name">${escapeHtml(service.label || service.name)}</span></a>`;
    const tileGrid = services => `<div class="tiles" style="--item-count:${Math.max(1, services.length)}">${services.map(tile).join('')}</div>`;
    function renderCategory(category, services) {
      const sorted = [...services].sort((a,b) => (a.order || 999) - (b.order || 999));
      const direct = sorted.filter(service => !service.subcategory);
      const subgroups = sorted.reduce((result, service) => { if (service.subcategory) (result[service.subcategory] ||= []).push(service); return result; }, {});
      const nested = Object.entries(subgroups).map(([name, items]) => `<details class="subgroup" open><summary class="subgroup-summary"><span>${escapeHtml(name)}</span><span class="group-count">${items.length}</span></summary>${tileGrid(items)}</details>`).join('');
      return `<details class="portal-group" data-category="${escapeHtml(category)}" open><summary class="group-summary"><span>${escapeHtml(category)}</span><span class="group-count">${sorted.length}</span></summary><div class="group-body">${direct.length ? tileGrid(direct) : ''}${nested}</div></details>`;
    }
    function setAvailability(serviceId, available) {
      const card = document.querySelector(`[data-service-id="${CSS.escape(serviceId)}"]`);
      if (!card) return;
      card.classList.remove('is-checking', 'is-up', 'is-down');
      card.classList.add(available ? 'is-up' : 'is-down');
      card.querySelector('.availability').textContent = available ? 'доступен' : 'недоступен';
    }
    async function refreshAvailability(services) {
      const results = await Promise.all(services.map(async service => {
        try {
          const response = await fetch(`/portal-health/${encodeURIComponent(service.id)}.json`, {cache:'no-store'});
          if (!response.ok) throw new Error('health snapshot missing');
          const health = await response.json();
          setAvailability(service.id, health.available === true);
          return health.available === true;
        } catch (_) {
          setAvailability(service.id, false);
          return false;
        }
      }));
      document.getElementById('status').textContent = `Доступно: ${results.filter(Boolean).length} / ${services.length}`;
    }
    async function loadServices() {
      const root = document.getElementById('services');
      const status = document.getElementById('status');
      try {
        const listing = await fetch('/portal-services/', {cache:'no-store'}).then(response => response.json());
        const files = listing.filter(item => item.type === 'file' && item.name.endsWith('.json'));
        const services = await Promise.all(files.map(async item => ({...(await fetch('/portal-services/' + encodeURIComponent(item.name), {cache:'no-store'}).then(response => response.json())), id:item.name.replace(/\.json$/, '')})));
        const categories = ['Infra', 'Observability', 'Service'];
        const grouped = services.reduce((result, service) => { const category = service.category || 'Service'; (result[category] ||= []).push(service); return result; }, {});
        root.innerHTML = categories.filter(category => grouped[category]?.length).map(category => renderCategory(category, grouped[category])).join('');
        if (!services.length) root.innerHTML = '<div class="empty">Сервисы будут появляться здесь по мере установки этапов.</div>';
        status.textContent = `Проверка: 0 / ${services.length}`;
        await refreshAvailability(services);
        window.setInterval(() => refreshAvailability(services), 30000);
      } catch (_) { root.innerHTML = '<div class="empty">Не удалось загрузить список сервисов.</div>'; status.textContent = 'Ошибка'; }
    }
    loadServices();
  </script>
</body>
</html>
