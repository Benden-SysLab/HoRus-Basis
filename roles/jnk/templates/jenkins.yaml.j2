jenkins:
  systemMessage: "HoRus Jenkins controller managed by Ansible. Builds run on dedicated agents."
  numExecutors: 0
  mode: EXCLUSIVE
  disableRememberMe: false
{% if jenkins_agent_enabled | bool %}
  nodes:
    - permanent:
        name: "{{ jenkins_agent_name }}"
        nodeDescription: "HoRus dedicated Linux build agent"
        remoteFS: "{{ jenkins_agent_remote_fs }}"
        numExecutors: {{ jenkins_agent_executors }}
        mode: EXCLUSIVE
        labelString: "{{ jenkins_agent_labels }}"
        retentionStrategy: "always"
        launcher:
          ssh:
            host: "{{ jenkins_agent_address }}"
            port: 22
            credentialsId: "{{ jenkins_agent_credentials_id }}"
            javaPath: /usr/bin/java
            maxNumRetries: 5
            retryWaitTime: 15
            sshHostKeyVerificationStrategy:
              manuallyProvidedKeyVerificationStrategy:
                key: "{{ jenkins_agent_ssh_host_key }}"
{% endif %}
  securityRealm:
    oic:
      serverConfiguration:
        wellKnown:
          wellKnownOpenIDConfigurationUrl: "{{ jenkins_oidc_discovery_url }}"
          scopesOverride: "openid profile email"
      clientId: "{{ jenkins_oidc_client_id }}"
      clientSecret: "{{ jenkins_oidc_client_secret }}"
      userNameField: "preferred_username"
      fullNameFieldName: "name"
      emailFieldName: "email"
      logoutFromOpenidProvider: true
      postLogoutRedirectUrl: "{{ jenkins_public_url }}/"
      rootURLFromRequest: false
      disableSslVerification: false
      properties:
        - pkce
        - escapeHatch:
            username: "{{ jenkins_recovery_user }}"
            secret: "{{ jenkins_recovery_password }}"
            group: "jenkins-recovery"
  authorizationStrategy:
    globalMatrix:
      entries:
        - user:
            name: "{{ jenkins_admin_user }}"
            permissions:
              - "Overall/Administer"
        - user:
            name: "{{ jenkins_recovery_user }}"
            permissions:
              - "Overall/Administer"
unclassified:
  location:
    url: "{{ jenkins_public_url }}/"
{% if jenkins_agent_enabled | bool %}

credentials:
  system:
    domainCredentials:
      - credentials:
          - basicSSHUserPrivateKey:
              scope: SYSTEM
              id: "{{ jenkins_agent_credentials_id }}"
              username: "{{ jenkins_agent_user }}"
              description: "HoRus Jenkins agent SSH key"
              privateKeySource:
                directEntry:
                  privateKey: |-
{{ jenkins_agent_ssh_private_key | indent(20, true) }}
{% endif %}
