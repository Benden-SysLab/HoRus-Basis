[SERVICE]
    Flush        5
    Daemon       Off
    Log_Level    info
    Parsers_File {{ fluent_bit_parser_path }}

{% if fluent_bit_service_profile == 'jenkins' %}
[INPUT]
    Name              systemd
    Tag               horus.jenkins
    Systemd_Filter    _SYSTEMD_UNIT=jenkins.service
    Read_From_Tail    On
    DB                {{ fluent_bit_state_dir }}/jenkins-systemd.db
{% else %}
[INPUT]
    Name              tail
    Path              {{ fluent_bit_selected_tail_paths | default(fluent_bit_tail_paths) | join(',') }}
    Tag               horus.{{ fluent_bit_service_profile | default('host') }}
    Read_from_Head    False
    DB                {{ fluent_bit_state_dir }}/horus.db
{% if fluent_bit_service_profile == 'databases' %}
    Parser            horus_json
{% endif %}
    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
{% endif %}

[OUTPUT]
    Name              file
    Match             horus.*
    Path              {{ fluent_bit_output_path | dirname }}
    File              {{ fluent_bit_output_path | basename }}
    Format            plain

{% if fluent_bit_loki_enabled | bool %}
[OUTPUT]
    Name              loki
    Match             horus.*
    Host              {{ fluent_bit_loki_host }}
    Port              {{ fluent_bit_loki_port }}
    URI               {{ fluent_bit_loki_uri }}
    Labels            job=horus-fluent-bit,host={{ inventory_hostname }},profile={{ fluent_bit_service_profile }}
    Line_Format       json
{% endif %}

