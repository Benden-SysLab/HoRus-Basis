ui = true
disable_mlock = false
api_addr = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"
log_level = "info"
log_format = "json"
log_file = "{{ vault_log_dir }}/vault.log"

listener "tcp" {
  address = "0.0.0.0:{{ vault_api_port }}"
  cluster_address = "0.0.0.0:{{ vault_cluster_port }}"
  tls_disable = false
  tls_cert_file = "{{ vault_cert_file }}"
  tls_key_file = "{{ vault_key_file }}"
}

storage "postgresql" {
  connection_url = "postgres://{{ vault_postgres_user }}:{{ vault_postgres_password }}@{{ vault_postgres_host }}:{{ vault_postgres_port }}/{{ vault_postgres_database }}?sslmode=disable"
  table = "vault_kv_store"
  ha_enabled = "false"
}

telemetry {
  prometheus_retention_time = "30s"
  disable_hostname = true
}

