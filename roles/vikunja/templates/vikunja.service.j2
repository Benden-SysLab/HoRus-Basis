[Unit]
Description=HoRus Task Management (Vikunja)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ vikunja_system_user }}
Group={{ vikunja_system_group }}
WorkingDirectory={{ vikunja_data_dir }}
ExecStart={{ vikunja_binary_path }} --config {{ vikunja_config_path }}
Restart=on-failure
RestartSec=5s
Environment=HOME={{ vikunja_data_dir }}
StandardOutput=append:{{ vikunja_log_dir }}/vikunja.log
StandardError=append:{{ vikunja_log_dir }}/vikunja.log
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ vikunja_data_dir }} {{ vikunja_log_dir }}

[Install]
WantedBy=multi-user.target
